# ==============================================================================
# Island Configuration Example
# Copy this file to .env and insert your personal API keys.
# DO NOT commit your real .env file with secrets!
# ==============================================================================

# Google Gemini API Key (Multimodal Conversational Intelligence & Speech)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Ultra-fast Whisper Large V3 STT & Llama / Mixtral Chat Models)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key (Realtime Audio Companion fallback)
# OPENAI_API_KEY=your_openai_api_key_here

# Development Server URL (Default: http://127.0.0.1:5173)
# ISLAND_DEV_URL=http://127.0.0.1:5173
