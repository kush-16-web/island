{
  "manifest_version": 3,
  "name": "Dynamic Island Companion",
  "version": "1.1.0",
  "description": "Seamlessly syncs YouTube ambient lighting and enables exact YouTube Music favorites playback for Dynamic Island.",
  "permissions": [],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "http://127.0.0.1:47823/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": ["ytmusic-companion.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
